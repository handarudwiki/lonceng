{
  "expo": {
    "name": "Lonceng Sekolah",
    "slug": "lonceng-sekolah",
    "scheme": "lonceng",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "id.lonceng.sekolah",
      "supportsTablet": false
    },
    "android": {
      "package": "id.lonceng.sekolah"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Kamera dipakai untuk memindai QR siswa."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Galeri dipakai untuk melampirkan foto surat izin."
        }
      ],
      "expo-notifications",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
